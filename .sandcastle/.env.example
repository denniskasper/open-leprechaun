# Copy to .sandcastle/.env (gitignored): cp .sandcastle/.env.example .sandcastle/.env
#
# Claude Code OAuth token — get one by running `claude setup-token` on your host.
# Lets the agent use your Claude subscription instead of an API key.
CLAUDE_CODE_OAUTH_TOKEN=
# Or use an Anthropic API key instead — uncomment and fill in:
# ANTHROPIC_API_KEY=
#
# No GitHub token: the sandbox never talks to GitHub. The host's own `gh` login
# reads issues, pushes branches and opens pull requests (see main.mts).
