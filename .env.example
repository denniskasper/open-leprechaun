# Copy to .env before running anything: cp .env.example .env
#
# One file feeds all three pieces: Docker Compose reads it directly, the API
# reads it through pydantic-settings, and Vite reads it through envDir.

# --- Postgres (Docker Compose) ---
POSTGRES_USER=leprechaun
POSTGRES_PASSWORD=leprechaun
POSTGRES_DB=leprechaun
# Host port. Deliberately not 5432, so a Postgres already installed on the host
# does not collide with the container. Change it here and in DATABASE_URL if
# something else on your machine already holds it.
POSTGRES_PORT=5434

# --- API ---
# development | production. No default: an instance must say what it is.
# Only development may run the seed.
ENVIRONMENT=development
# The version the UI shows outside development; the deployment sets it, and
# unset it is the package version. Development shows the checked-out commit
# instead, falling back to this only outside a git checkout.
# RELEASE_VERSION=
DATABASE_URL=postgresql+psycopg://leprechaun:leprechaun@localhost:5434/leprechaun
# Root secret for encrypting venue credentials and the two-factor secret
# (ADR-0003, ADR-0005). Set a long random value in production and back it up
# outside the database — losing it means re-entering every venue credential
# and disabling two-factor from the host (docs/runbook.md). Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APPLICATION_SECRET=development-only-secret-not-for-production
API_HOST=127.0.0.1
API_PORT=8000
# Which provider resolves a security identifier to its Listings, and which
# quotes and backfills security prices. The default needs no paid plan.
# SECURITY_RESOLUTION_PROVIDER=onvista
# SECURITY_PRICE_PROVIDER=onvista
# How many hours a login session survives after its last authenticated request.
# Every request renews it (sliding expiry). Development skips login entirely.
# SESSION_TTL_HOURS=720
# How far a venue's stated balance may sit from the tracked one, in units of
# the Instrument, before reconciliation reports a gap. A run may state its own.
# RECONCILIATION_TOLERANCE=0.00000001
# The Solana JSON-RPC endpoint the Address Indexer reads. The default is the
# public endpoint: no key, but rate-limited — a provider's endpoint reads a
# long history faster.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Whether this process runs scheduled tasks (price updates, syncs) when they
# fall due. The schedules themselves are set in the app under Settings →
# Scheduled tasks; off, a task still runs on demand from there.
# SCHEDULER_ENABLED=true

# --- Web ---
WEB_PORT=5173
