# Copy to .env before running anything: cp .env.example .env
#
# One file feeds all three pieces: Docker Compose reads it directly, the API
# reads it through pydantic-settings, and Vite reads it through envDir.

# --- Postgres (Docker Compose) ---
POSTGRES_USER=leprechaun
POSTGRES_PASSWORD=leprechaun
POSTGRES_DB=leprechaun
# Host port. Deliberately not 5432, so a Postgres already installed on the host
# does not collide with the container. Change it here and in DATABASE_URL if
# something else on your machine already holds it.
POSTGRES_PORT=5434

# --- API ---
# development | production. No default: an instance must say what it is.
# Only development may run the seed.
ENVIRONMENT=development
# The version the UI shows outside development; the deployment sets it.
# Development ignores it and shows the checked-out commit instead.
# RELEASE_VERSION=
DATABASE_URL=postgresql+psycopg://leprechaun:leprechaun@localhost:5434/leprechaun
# Root secret for venue-credential encryption (ADR-0003). Set a long random
# value in production and back it up outside the database — losing it means
# re-entering every venue credential. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APPLICATION_SECRET=development-only-secret-not-for-production
API_HOST=127.0.0.1
API_PORT=8000
# How many hours a login session survives after its last authenticated request.
# Every request renews it (sliding expiry). Development skips login entirely.
# SESSION_TTL_HOURS=720

# --- Web ---
WEB_PORT=5173
